---
import { Image } from "astro:assets";

interface Props {
  title?: string;
  image?: string | any;
  svg?: string | any ;
  alt: string;
  columns?: 2 | 3 | 4; // Explicitly defining expected column counts
}

const { title, image, svg, alt, columns = 4 } = Astro.props;

// Dictionary mapping numbers to full, explicit Tailwind classes
const gridMap = {
  2: { total: "lg:grid-cols-2", text: "lg:col-span-1" },
  3: { total: "lg:grid-cols-3", text: "lg:col-span-2" },
  4: { total: "lg:grid-cols-4", text: "lg:col-span-3" },
};

// Fallback safely to 4 columns if an unsupported number is passed
const layoutClasses = gridMap[columns as keyof typeof gridMap] || gridMap[4];

const isSvg = true;

const imageClass = "flex lg:basis-full items-center py-2 object-none";
---
<div class="flex justify-center bg-white mx-5 sm:mx-10 h-full rounded-lg p-8 shadow-md">
  {/* Injected the explicit tailwind classes safely */}
  <div class={`grid grid-cols-1 ${layoutClasses.total} lg:space-x-10`}>
    <div class="flex items-center justify-center">
      {
        isSvg 
          ? <div class="h-full w-full [&>svg]:h-full [&>svg]:w-full" set:html={svg}/>
          : <Image src={image} alt={alt} class={imageClass} /> 
      }

    </div>
    <div class={`col-span-1 ${layoutClasses.text} space-y-2`}>
      <span class="text-2xl text-se-dark font-bold">{title}</span>
      <div class="text-se-muted text-m text-justify space-y-3">
        <slot name="content"/>
      </div>
      <div class="flex basis-full py-3">
        <slot name="buttons" />
      </div>
    </div>
  </div>
</div>
